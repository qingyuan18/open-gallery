{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPutCustomMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "ComfyUI"
        }
      }
    },
    {
      "Sid": "AllowReadMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData"
      ],
      "Resource": "*"
    }
  ]
}

